{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.2.3",
  "description": "A native desktop shell for DeepSeek Harness (dsh) on macOS and Windows, with Codex-desktop-style conveniences: managed backend, remote SSH projects, native menu & shortcuts, tray, notifications and multi-window.",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "author": "DSH Desktop contributors",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "pnpm": "11.21.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DSH Desktop",
    "asar": false,
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "vendor/**/*",
      "node_modules/@deepseek-ai/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "node_modules/@deepseek-ai",
        "to": "app/node_modules/@deepseek-ai",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop"
    }
  }
}
